{
  "manifest_version": 3,
  "name": "KNLTB Rating Inline",
  "version": "2.34.0",
  "description": "Toont de KNLTB enkel- en dubbelrating direct achter spelersnamen op mijnknltb.toernooi.nl.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mijnknltb.toernooi.nl/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mijnknltb.toernooi.nl/*"
      ],
      "js": [
        "site.js",
        "dss.js",
        "parse.js",
        "bracket.js",
        "history.js",
        "diagnose.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KNLTB Rating Inline",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}